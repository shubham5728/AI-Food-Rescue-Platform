# ---------------------------------------------------------------------------
# FoodBridge AI — environment
#
# NOTHING here is required to run the app. With no .env.local at all the app
# boots in "demo mode": an in-memory database seeded with realistic data and a
# deterministic scoring engine. Add keys to upgrade each layer independently.
# ---------------------------------------------------------------------------

# --- AI layer --------------------------------------------------------------
# Without this, waste-risk / match / priority scores still come from the
# deterministic engine and explanations are generated from the score breakdown.
# With it, the LLM re-ranks within a bounded window and writes the prose.
# Server-side only — never prefix with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Persistence layer -----------------------------------------------------
# Without these, data lives in memory and resets when the server restarts.
# Run supabase/schema.sql in the Supabase SQL editor, then fill these in.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: server-side only. Bypasses RLS for the API routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Session ---------------------------------------------------------------
# Signs the session cookie. Generate with: openssl rand -base64 32
SESSION_SECRET=
